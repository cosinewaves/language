-- comprehensive block scoping test
-- this tests all scoping features to verify they work correctly

set globalVar = 100
set result = 0

-- test 1: nested iterate loops (the main fix!)
iterate (set i = 1, i <= 3, i += 1) then
    iterate (set j = 1, j <= 3, j += 1) then
        set innerProduct = i * j
        result += innerProduct
    finish
finish

-- result should be 36 (sum of 1*1, 1*2, 1*3, 2*1, 2*2, 2*3, 3*1, 3*2, 3*3)

-- test 2: whilst loop with fresh scope each iteration
set counter = 0
whilst (counter < 3) then
    set loopVar = counter + 10
    result += loopVar
    counter += 1
finish

-- added 10, 11, 12 = 33, so result is now 36 + 33 = 69

-- test 3: reusing loop variable names
iterate (set k = 1, k <= 2, k += 1) then
    result += k
finish

iterate (set k = 5, k <= 6, k += 1) then
    result += k
finish

-- added 1, 2, 5, 6 = 14, so result is now 69 + 14 = 83

-- test 4: if statement scoping
given (globalVar > 50) then
    set ifVar = 17
    result += ifVar
finish

-- added 17, so result is now 83 + 17 = 100

result
